# Server is intentionally restricted to loopback.
HOST=127.0.0.1
PORT=7391
# Extra allowed origins for an explicitly separate frontend. npm run dev adds
# its own origins while preserving this value; production has no dev origins.
FRONTEND_ORIGIN=

DOWNLOAD_DIR=./downloads
STATE_DIR=./.yt-dls
# Empty means automatic discovery, preferring the project-local .venv.
YTDLP_PATH=
# Empty auto-detects Deno or Node; explicit example: node:C:\Program Files\nodejs\node.exe
YTDLP_JS_RUNTIME=

LOG_LEVEL=info
MAX_CONCURRENT_DOWNLOADS=3
MAX_CONCURRENT_INFO=4
INFO_TIMEOUT_MS=120000
MAX_DOWNLOAD_DURATION_MS=1800000
INFO_MAX_OUTPUT_BYTES=16777216

# These opt-ins are only appropriate for a trusted local machine.
ALLOW_CUSTOM_DOWNLOAD_PATH=false
ALLOW_DANGEROUS_OPTIONS=false
ALLOW_PRIVATE_URLS=false
