      "response": "Admission"
    },
    {
      "method": "GET",
      "path": "/api/download/{id}/status",
      "response": "ProgressSnapshot"
    },
    {
      "method": "DELETE",
      "path": "/api/download/{id}",
      "response": "Success"
    },
    {
      "method": "POST",
      "path": "/api/download/{id}/cancel",
      "response": "Success"
    },
    {
      "method": "GET",
      "path": "/api/download/{id}/log",
      "response": "Log"
    },
    {
      "method": "POST",
      "path": "/api/download/{id}/retry",
      "request": "RetryRequest",
      "response": "Admission"
    },
    {
      "method": "GET",
      "path": "/api/download/{id}/file/{index}",
      "response": "BinaryFile"
    },
    {
      "method": "GET",
      "path": "/api/download/{id}/files",
      "response": "RetainedPreview"
    },
    {
      "method": "POST",
      "path": "/api/download/{id}/files/cleanup",
      "request": "CleanupRequest",
      "response": "CleanupResult"
